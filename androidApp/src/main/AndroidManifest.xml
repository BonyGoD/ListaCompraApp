<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permiso requerido para usar AdMob en Android 13+ (API 33+) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

    <application
        android:name="dev.bonygod.listacompra.ListaCompraApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- AdMob App ID (viene de BuildConfig/local.properties) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAndroidAppId}"/>

        <!--
            adjustResize y no el valor por defecto: sin declararlo, el sistema puede elegir
            adjustPan, que al abrir el teclado recorre la jerarquía buscando la vista con
            foco para desplazarla (ViewRootImpl.scrollToRectOrFocus). Si esa vista ya se ha
            quitado -un TextField que desaparece con el teclado abierto- el recorrido se
            topa con un padre nulo y la app se cae con "parameter must be a descendant of
            this view". Es el crash de 1.5.0 en Crashlytics.
        -->
        <activity
            android:exported="true"
            android:name="dev.bonygod.listacompra.MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

